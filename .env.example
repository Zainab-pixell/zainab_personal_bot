# Copy this file to .env and fill in real values. Never commit .env itself.

# Your Groq API key (from console.groq.com). Used only on the server, never sent to the browser.
GROQ_API_KEY=

# Login credentials for the web UI. Choose your own values.
APP_USERNAME=
APP_PASSWORD=

# Random string used to sign the login session cookie. Any long random value works.
SESSION_SECRET=
