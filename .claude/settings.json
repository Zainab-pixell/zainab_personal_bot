{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh",
            "timeout": 180,
            "statusMessage": "Installing PDF generation tools (pandoc, weasyprint, etc.)..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/daily-wrap-up-notify.py",
            "timeout": 10,
            "statusMessage": "Checking if a notes/ file changed..."
          }
        ]
      }
    ]
  }
}
